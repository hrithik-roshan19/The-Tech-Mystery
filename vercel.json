{
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/.__clerk/:path*",
      "destination": "/api/clerk?path=:path*"
    },
    {
      "source": "/__clerk/:path*",
      "destination": "/api/clerk?path=:path*"
    },
    {
      "source": "/.__clerk",
      "destination": "/api/clerk"
    },
    {
      "source": "/__clerk",
      "destination": "/api/clerk"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
