# Copy to verification/.env.local (Git ignored); never paste real keys in chat.
# Separate Clerk DEVELOPMENT application only. These blanks are not credentials.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5175
# Optional PEM public key. Leave blank to use SDK key retrieval.
CLERK_JWT_KEY=
# Do not add a MongoDB URI: the launcher generates and proves its own target.
