# ==============================================================================
# HACK THE GRID - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in local development, or set respective keys in server/.env
# and client/.env (or your hosting platforms: Vercel, Render/Railway, MongoDB Atlas).
# DO NOT commit real secret values to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER ENVIRONMENT VARIABLES (Backend - Node.js / Express)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String (Atlas URI or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://hackthegrid_dev:<password>@cluster0.example.mongodb.net/hack_the_grid?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_hmac_sha256_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origins (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
SUBMISSION_RATE_LIMIT_MAX_REQUESTS=10

# QR Token Cryptographic Salt / Secret (Used for checkpoint HMAC validation)
QR_SECRET_SALT=cyber_qr_hmac_salt_for_tamperproof_verification_token

# Master Flag & Admin Bootstrap Defaults (Optional seed defaults)
ADMIN_BOOTSTRAP_KEY=codesphere_admin_bootstrap_key_2026
ADMIN_EMAIL=admin@codesphere.tulas.edu.in
ADMIN_DEFAULT_PASSWORD=12345

# Logging & Monitoring
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# CLIENT ENVIRONMENT VARIABLES (Frontend - React / Vite)
# Note: Vite requires VITE_ prefix to expose variables to the browser runtime.
# NEVER put server secrets or answer flags in client variables!
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Hack the Grid"
VITE_ORGANIZER_NAME="CodeSphere Coding Club"
VITE_UNIVERSITY_NAME="Tula's University, Dehradun"
VITE_EVENT_TIMEZONE="Asia/Kolkata"

