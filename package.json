{
  "name": "the-tech-mystery",
  "version": "1.0.0",
  "description": "The Tech Mystery - Flagship Cybersecurity CTF Web Application for CodeSphere Coding Club, Tula's University",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "start:server": "npm run start --workspace=server",
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "install:all": "npm install --workspaces",
    "db:sync-indexes": "npm run db:sync-indexes --workspace=server",
    "dev:clerk": "node server/scripts/clerk-development.js --start server/.env client/.env --configured-frontend"
  },
  "keywords": [
    "ctf",
    "cybersecurity",
    "the-tech-mystery",
    "codesphere",
    "tulas-university",
    "qr-checkpoint"
  ],
  "author": "CodeSphere Coding Club, Tula's University",
  "license": "UNLICENSED"
}
