# ==============================================================================
# THE TECH MYSTERY - CLIENT ENVIRONMENT VARIABLES (Vite)
# ==============================================================================
# All variables exposed to Vite client code must start with VITE_
# IMPORTANT: NEVER store server secrets, encryption salts, or CTF flags here!
# ==============================================================================

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="The Tech Mystery"
VITE_ORGANIZER_NAME="CodeSphere Coding Club"
VITE_UNIVERSITY_NAME="Tula's University, Dehradun"
VITE_EVENT_TIMEZONE="Asia/Kolkata"
VITE_LEADERBOARD_REFRESH_INTERVAL_MS=15000


# Must match backend AUTH_PROVIDER; rebuild after changing.
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=


