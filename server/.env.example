# ==============================================================================
# THE TECH MYSTERY - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String (Atlas URI or local instance)
MONGODB_URI=mongodb+srv://hackthegrid_dev:<password>@cluster0.example.mongodb.net/hack_the_grid?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_hmac_sha256_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
SUBMISSION_RATE_LIMIT_MAX_REQUESTS=10

# Cryptographic QR HMAC Secret Salt
QR_SECRET_SALT=cyber_qr_hmac_salt_for_tamperproof_verification_token
QUESTION_CLAIM_TIMEOUT_MINUTES=30

# Admin Bootstrap Credentials (Used for initial seed if DB is empty)
ADMIN_BOOTSTRAP_KEY=codesphere_admin_bootstrap_key_2026
ADMIN_EMAIL=admin@codesphere.tulas.edu.in
ADMIN_DEFAULT_PASSWORD=ChangeMeOnFirstDeployment#2026

# Logging Level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=debug


# Authentication rollout: default remains legacy until separately approved.
AUTH_PROVIDER=jwt
# Required only when AUTH_PROVIDER=clerk. Never prefix these with VITE_.
CLERK_SECRET_KEY=
# Exact session iss origin (https://...; no trailing slash), from Clerk application.
CLERK_JWT_ISSUER_DOMAIN=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Optional PEM public verification key; supports literal \n separators.
# Without this key, the official SDK retrieves Clerk's verification keys.
CLERK_JWT_KEY=
